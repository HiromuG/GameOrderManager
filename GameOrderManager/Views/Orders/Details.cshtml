@{
}
@model GameOrderManager.Models.Order

@{
    ViewData["Title"] = "受注詳細";
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="mb-1">受注詳細</h1>
                <p class="text-muted mb-0">受注番号 #@Model.Id</p>
            </div>

            @if (Model.Status == "未處理")
            {
                <span class="badge bg-secondary">未処理</span>
            }
            else if (Model.Status == "處理中")
            {
                <span class="badge bg-warning text-dark">処理中</span>
            }
            else if (Model.Status == "已完成")
            {
                <span class="badge bg-success">完了</span>
            }
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="text-muted small">顧客名</div>
                <div class="fw-semibold">@Model.CustomerName</div>
            </div>

            <div class="col-md-6">
                <div class="text-muted small">商品名</div>
                <div class="fw-semibold">@Model.ProductName</div>
            </div>

            <div class="col-md-6">
                <div class="text-muted small">プラットフォーム</div>
                <div class="fw-semibold">@Model.Platform</div>
            </div>

            <div class="col-md-6">
                <div class="text-muted small">数量</div>
                <div class="fw-semibold">@Model.Quantity</div>
            </div>

            <div class="col-md-6">
                <div class="text-muted small">単価</div>
                <div class="fw-semibold">¥@Model.UnitPrice.ToString("N0")</div>
            </div>
        </div>

        <hr class="my-4" />

        <div class="d-flex gap-2">
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                編集
            </a>

            <button type="button"
                    class="btn btn-outline-secondary"
                    onclick="history.back()">
                戻る
            </button>
        </div>
    </div>
</div>